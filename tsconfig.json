{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "moduleResolution": "node",
    "types": ["node", "mocha", "chai"]
  },
  "include": ["app/**/*.ts", "app/**/*.d.ts", "scripts/**/*.ts"]
}
